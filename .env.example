# Use process environment or a local ignored .env. Do not put keys in the browser.
USTC_API_KEY=
# Optional provider profiles used by the /agent model selector.
NINEE_API_KEY=
H800_API_KEY=
CAD_AGENT_BASE_URL=http://60.171.65.125:30539
CAD_AGENT_MODEL=Qwen3.8-27B-FP8
CONTOUR_API_BASE=https://api.llm.ustc.edu.cn/v1
CONTOUR_MODEL=qwen-chat
CONTOUR_API_TIMEOUT=60
# Set false if a local proxy prevents the USTC TLS connection. TLS verification stays enabled.
CONTOUR_TRUST_ENV=false
CONTOUR_PORT=8769
# Optional locally trained segmentation model. These files are intentionally not committed.
CONTOUR_SEGMENTATION_CHECKPOINT=runtime/segmentation/runs/unet-r18-dxf-v2/best.pt
CONTOUR_SEGMENTATION_MANIFEST=runtime/segmentation/gt-data-v3/manifest.json
